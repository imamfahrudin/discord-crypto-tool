# ============================================================
# Discord Crypto Tool - Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------
# 1. Discord Bot Credentials & Core Settings
# ------------------------------------------------------------
# Either DISCORD_TOKEN or DISCORD_BOT_TOKEN will be accepted.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
BOT_TITLE_PREFIX=💎 CRYPTO SIGNAL —
BOT_FOOTER_NAME=Crypto Bot

# Enable Cloudflare WARP VPN (true/false) for bypass/DNS over HTTPS in Docker
USE_WARP=false

# ------------------------------------------------------------
# 2. Crypto Screening Tool Module Settings
# ------------------------------------------------------------
# Default number of candles fetched for technical analysis
OHLC_LIMIT=500

# Concurrency semaphore for chart & signal generation to protect RAM
SIGNAL_CONCURRENCY=2

# ------------------------------------------------------------
# 3. Crypto VWAP Scanner Module Settings
# ------------------------------------------------------------
# Maximum number of Bybit linear symbols to scan
MAX_SYMBOLS=120

# Max concurrent candle fetches per scan (lower = lower peak RAM, 20 is optimal)
CANDLE_FETCH_CONCURRENCY=20

# Enable real-time Bybit WebSocket ticker stream (optional, off by default to save CPU/RAM)
ENABLE_WEBSOCKET_PRICES=false

# Refresh intervals in seconds (comma-separated for multi-table auto-updates)
# Examples: "300" (single 5m table) or "300,900,1800,3600" (5m, 15m, 30m, 1h tables)
REFRESH_INTERVAL=300

# Top N symbols displayed in the VWAP ranking table
TOP_N=15

# Minimum 24h trading volume threshold in Million USDT
MIN_VOLUME_M=0.3

# Signal classification score thresholds
STRONG_SCORE=80
BUY_SCORE=25
SELL_SCORE=-25
STRONG_SELL_SCORE=-80

# Session weights as JSON object
SESSION_WEIGHTS={"Sydney": 0.6, "Tokyo": 0.8, "London": 1.0, "New York": 1.2}

# Custom text footers (optional - leave blank for default)
TABLE_FOOTER_TEXT=
EMBED_FOOTER_TEXT=

# Rate limiter settings for Discord message edits
RATE_LIMIT_MIN_INTERVAL=1.0
RATE_LIMIT_MAX_BURST=3
UPDATE_STAGGER_DELAY=0.5

# ------------------------------------------------------------
# 4. Forex Factory Notifier Module Settings
# ------------------------------------------------------------
# Maximum number of upcoming events shown below Today's section
FOREX_MAX_UPCOMING=5

# Minimum impact level to include: high | medium | low | all
FOREX_MIN_IMPACT=high

# Comma-separated currencies to filter (e.g. USD,EUR,GBP). Leave blank for all.
FOREX_CURRENCIES=

# Timezone used for date grouping and scheduling (pytz name)
FOREX_TIMEZONE=Asia/Jakarta

# Hour (0-23) in FOREX_TIMEZONE at which the daily post fires each day
FOREX_SCHEDULE_HOUR=7

# Minute (0-59) for the daily post
FOREX_SCHEDULE_MINUTE=0

# Discord embed title prefix
FOREX_EMBED_TITLE=Forex Alerts

# Footer server name shown in the embed
FOREX_SERVER_NAME=Forex Notifier

# Embed accent color in hex without 0x (FF4500 = orange-red)
FOREX_EMBED_COLOR=FF4500

# Maximum characters for event titles before truncation
FOREX_MAX_EVENT_TITLE_LENGTH=30

# HTTP fetch settings (advanced — usually no need to change)
FOREX_MAX_RETRIES=3
FOREX_INITIAL_SLEEP_SECONDS=5
FOREX_REQUEST_TIMEOUT=10
# FOREX_USER_AGENT=Mozilla/5.0 ...

# ------------------------------------------------------------
# 5. Degen Token Lookup Module Settings
# ------------------------------------------------------------
# Paste a contract address in chat (no prefix command). The bot replies with
# DexScreener market data, a GeckoTerminal candlestick chart, and price buttons.
# There is no second Discord token. DISCORD_TOKEN above is the only bot token.
# The standalone degen bot's TOKEN setting is not used.

# Embed accent color as a decimal integer (9442302 = #901B6E)
PRIMARY_COLOR=9442302

# Footer text on degen token embeds
FOOTER_TEXT=DO YOUR OWN RESEARCH-ALWAYS!

# Hourly candles pulled for the degen chart (168 = 7 days of 1h bars, max 1000)
CHART_TIMEFRAME_HOURS=168

# Max simultaneous degen lookups. Independent of SIGNAL_CONCURRENCY.
DEGEN_CONCURRENCY=2
